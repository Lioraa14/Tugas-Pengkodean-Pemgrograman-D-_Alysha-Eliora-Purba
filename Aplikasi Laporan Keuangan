<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Laporan Keuangan April 2025</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f9f6f2;
      margin: 0;
      padding: 30px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .container {
      background-color: #ffffff;
      border-radius: 14px;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
      width: 95%;
      max-width: 800px;
      padding: 30px;
    }

    .logo {
      width: 60px;
      display: block;
      margin: 0 auto 15px;
    }

    h2 {
      text-align: center;
      font-size: 24px;
      color: #5c4033;
      margin-bottom: 25px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    thead {
      background-color: #7b4a2d;
      color: white;
    }

    th, td {
      padding: 14px;
      text-align: center;
    }

    tbody tr:nth-child(even) {
      background-color: #f1e9e3;
    }

    tbody tr:hover {
      background-color: #e8d9d0;
    }

    tfoot {
      font-weight: bold;
      background-color: #d8c3b1;
      color: #3d2a1a;
    }

    .highlight {
      background-color: #ffe8cc !important;
      font-style: italic;
    }

    .total-row {
      background-color: #e2d3c2;
    }
  </style>
</head>
<body>
  <div class="container">
    <img class="logo" src="https://cdn-icons-png.flaticon.com/512/2920/2920058.png" alt="Finance Icon" />
    <h2>Laporan Keuangan April 2025</h2>
    <table>
      <thead>
        <tr>
          <th>Tanggal</th>
          <th>Deskripsi</th>
          <th>Pendapatan (Rp)</th>
          <th>Pengeluaran (Rp)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>01/04/2025</td>
          <td>Penjualan Menu Spesial</td>
          <td>2.500.000</td>
          <td>-</td>
        </tr>
        <tr>
          <td>02/04/2025</td>
          <td>Pembelian Biji Kopi</td>
          <td>-</td>
          <td>1.000.000</td>
        </tr>
        <tr class="highlight">
          <td>03/04/2025</td>
          <td>Promosi Sosial Media</td>
          <td>-</td>
          <td>500.000</td>
        </tr>
        <tr>
          <td>04/04/2025</td>
          <td>Penjualan Paket Hemat</td>
          <td>3.200.000</td>
          <td>-</td>
        </tr>
        <tr>
          <td>06/04/2025</td>
          <td>Biaya Sewa Bulanan</td>
          <td>-</td>
          <td>2.000.000</td>
        </tr>
        <tr>
          <td>08/04/2025</td>
          <td>Penjualan Online</td>
          <td>2.000.000</td>
          <td>-</td>
        </tr>
        <tr>
          <td>10/04/2025</td>
          <td>Servis Peralatan</td>
          <td>-</td>
          <td>750.000</td>
        </tr>
        <tr>
          <td>12/04/2025</td>
          <td>Penjualan Minuman Botol</td>
          <td>1.500.000</td>
          <td>-</td>
        </tr>
      </tbody>
      <tfoot>
        <tr class="total-row">
          <td colspan="2">Total</td>
          <td>9.200.000</td>
          <td>4.250.000</td>
        </tr>
      </tfoot>
    </table>
  </div>
</body>
</html>
